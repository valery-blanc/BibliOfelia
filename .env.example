# BibliOfelia — exemple de configuration
# Copier vers .env (dev) ou alimenter via secrets Docker (prod)

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,bibliofelia.local

# URL préfixe (cohabitation keebee : /bibliofelia/)
FORCE_SCRIPT_NAME=/bibliofelia
STATIC_URL=/bibliofelia/static/
MEDIA_URL=/bibliofelia/media/

# Base de données
DATABASE_PATH=/app/data/bibliofelia.sqlite3

# CSRF / sécurité (prod)
CSRF_TRUSTED_ORIGINS=https://bibliofelia.local
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_AGE=28800

# Langue par défaut (sera surchargée par Setting `default_language`)
DEFAULT_LANGUAGE=fr
ENABLED_LANGUAGES=fr,en,es,mg

# OpenLibrary
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_TIMEOUT=5

# Backups
BACKUP_USB_PATH=/backup
BACKUP_HOURLY=true
CLOUD_BACKUP_ENABLED=false
RCLONE_REMOTE=

# ZeroTier (informatif, lu en lecture seule)
ZEROTIER_NETWORK_ID=
